# Public origin used for canonical URLs, social cards, the sitemap and robots.txt.
# Optional: on Vercel the project's production domain is used when unset,
# and locally it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-only demo: sample data stored in localStorage, demo sign-in buttons,
# the demo banner and the dashboard role switch. Defaults to on.
# Set to "false" once lib/data/* is connected to a real backend.
NEXT_PUBLIC_DEMO_MODE=true
